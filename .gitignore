# ===========================
# Java / Maven
# ===========================
**/target/
!**/src/main/**/target/
!**/src/test/**/target/
!.mvn/wrapper/maven-wrapper.jar

# ===========================
# IntelliJ IDEA
# ===========================
**/.idea/
**/*.iml
**/*.ipr
**/*.iws
**/out/

# ===========================
# OS
# ===========================
**/.DS_Store
**/Thumbs.db
**/desktop.ini

# ===========================
# Логи приложения (КРИТИЧНО!)
# В логах могут быть токены!
# ===========================
**/*.log
**/logs/
**/app-logs/

# ===========================
# Загруженные пользователями файлы
# ===========================
**/files/
**/app-files/

# ===========================
# Node.js (для фронтенда, если он в этом же репо)
# ===========================
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# ===========================
# Переменные окружения с секретами
# ===========================
**/.env.local
**/.env.*.local

# ===========================
# Временные файлы
# ===========================
**/*.swp
**/*.swo
**/*~